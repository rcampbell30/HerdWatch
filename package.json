{
  "name": "herdwatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 -m pip install -r requirements.txt && npm run data:cover:all && npm run build:static",
    "build:static": "npm run map:validate && vite build && node scripts/create-static-route-entrypoints.mjs && node scripts/create-sitemap.mjs && npm run seo:audit && node scripts/inject-adsense-meta.mjs && node scripts/apply-public-branding.mjs",
    "seo:audit": "node scripts/audit-sitemap.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "repo:hygiene": "node scripts/repo-hygiene.mjs",
    "data:download": "node scripts/download-cover-sources.mjs",
    "data:cover:areas": "python3 scripts/build-cover-areas-netlify.py",
    "data:cover:trends": "python3 scripts/build-cover-trends.py",
    "data:cover:all": "npm run data:download && npm run data:cover:areas && npm run data:cover:trends && npm run data:build && npm run data:places",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/build-data.mjs && npm run map:validate",
    "map:geography": "python3 scripts/build-map-geography.py",
    "map:validate": "node scripts/validate-map-data.mjs",
    "data:places": "python3 scripts/build-search-places.py",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "maplibre-gl": "5.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
